# The two local edits that app2nix's generated default.nix does not produce.
# update.sh applies this to each freshly generated file; `patch` skips this
# header and starts at the first ---/+++ pair below.
#
# 1. nixpkgs dropped the `pkgs.xorg.*` aliases this channel resolves, so the
#    X11 inputs are named at the lowercase top level instead (commit 6c06fc1).
# 2. The vendor .desktop hardcodes Exec=/opt/iRealPro/irealpro, which does not
#    exist in the store, and files the app under a bare Categories=Audio; that
#    lands it in the launcher's Lost & Found. The installPhase addition rewrites
#    both (commits 6c06fc1, a60001e).
#
# Regenerate with:
#   diff -u <raw app2nix output> pkgs/irealpro/default.nix
# then re-add this header and rewrite the ---/+++ paths to default.nix.
--- default.nix
+++ default.nix
@@ -36,13 +36,13 @@
     pkgs.nss
     pkgs.pango
     pkgs.systemd
-    pkgs.xorg.libX11
-    pkgs.xorg.libXcomposite
-    pkgs.xorg.libXdamage
-    pkgs.xorg.libXext
-    pkgs.xorg.libXfixes
-    pkgs.xorg.libXrandr
-    pkgs.xorg.libxcb
+    pkgs.libx11
+    pkgs.libxcomposite
+    pkgs.libxdamage
+    pkgs.libxext
+    pkgs.libxfixes
+    pkgs.libxrandr
+    pkgs.libxcb
   ];
 
   unpackPhase = ''
@@ -93,6 +93,14 @@
             pkgs.systemd
         ]}" \
         --add-flags "--no-sandbox"
+
+      # The vendor .desktop hardcodes Exec=/opt/iRealPro/irealpro, which does
+      # not exist here. Point it at the wrapper so the launcher entry works.
+      if [ -f $out/share/applications/irealpro.desktop ]; then
+        substituteInPlace $out/share/applications/irealpro.desktop \
+          --replace "/opt/iRealPro/irealpro" "$out/bin/irealpro" \
+          --replace "Categories=Audio;" "Categories=AudioVideo;Audio;Music;"
+      fi
     fi
   '';
