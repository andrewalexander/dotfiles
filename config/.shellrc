#!/bin/sh

HISTSIZE=10000
SAVEHIST=10000

#stty -ixon # Disable ctrl-s and ctrl-q.
export RIPGREP_CONFIG_PATH=$HOME/.ripgreprc
export EDITOR=vim

# use exa on mac when available
if command -v exa >/dev/null; then
    alias ls='exa'
    alias ll='ls -alFh --group-directories-first'
    alias lld='ls -alFhD --group-directories-first'
    alias lt='ls -lhaFT -L 2 --group-directories-first'
    alias ltd='ls -lhaFTD -L 2 --group-directories-first'
else
    alias ll='ls -alFh --group-directories-first'
fi

alias e="$EDITOR"
alias p="sudo pacman"
alias SS="sudo systemctl"
alias gs='git status'
alias gd='git diff'
alias nst='netstat -tunlp' # "tunnel p"
alias si='sudo -i'
alias dnstools='kubectl run -it --rm --restart=Never --image=infoblox/dnstools:latest dnstools'
alias jc='journalctl --no-tail -xeu'
# framework 12: the ILIT2901 digitizer periodically floods the kernel with
# "i2c_hid_get_input: incomplete report", which shows up as phantom double
# taps, sticky clicks and a jumping cursor. rebinding the driver clears it.
alias fix-touch='sudo rmmod hid_multitouch && sudo modprobe hid_multitouch'
# count the errors above - rises while the digitizer is misbehaving, 0 when healthy
alias touch-errs='journalctl --since "60 sec ago" | grep -c "incomplete report"'
# keeping this around for nostalgia - doing dev work in tmux on shared ec2s 🥲
#alias vim="vim --servername vim-$(tmux display -p '#S')"

#source $HOME/.securerc
mkssh() { eval "$(ssh-agent -s)" }
mkgif() { ffmpeg -i $1 -filter_complex "[0:v] fps=12,scale=width=1080:height=-1,split [a][b];[a] palettegen [p];[b][p] paletteuse" -f gif $2 }
