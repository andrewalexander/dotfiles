From 18bf3f202dd5aed07dabc0ab95de0d892f8be1c5 Mon Sep 17 00:00:00 2001
From: Andrew Alexander <andrewalex1992@gmail.com>
Date: Sat, 24 Oct 2026 23:10:35 -0400
Subject: [PATCH] HID: i2c-hid: add quirk for an unreliable input length prefix

The ILITEK ILI2901 digitizer on the Framework Laptop 12 (222a:5539)
returns a corrupted input length prefix. Tracing i2c_reply on the
controller shows only 145 of 695 reads (20.9%) carry the correct
0x0042, while the report payload behind it is intact in 538 of the
remaining 550 (97.8%):

  byte 0   count   note
  0x42       145   correct
  0x00       404   zeroed
  0xff        21   all-ones
  0x84         7   0x42 << 1
  other       118   values occurring elsewhere in the report

In 546 of those 550 reads (99.3%) only byte 0 differs; bytes 1 onward
are unchanged. Two reads carried the whole buffer one byte late, with
the correct 0x42 landing in byte 1.

i2c_hid_get_input() validates the prefix only against wMaxInputLength
and never against the size the report descriptor declares, so a value
in [2,66] is accepted and handed to hid_report_raw_event(), which
zero-fills the absent tail. Fields that never arrived then read as
zero: the tip switch at byte 1 bit 0 clears, giving a phantom pen-up,
and tip pressure at bytes 6-7 reads 0. Values outside [2,66] are
rejected outright, and a prefix of 0 is swallowed as "RESET completed"
even when no reset is pending.

Measured over one slow stylus drag, before and after:

                        before      after
  reports delivered      95/s   115-146/s
  short reports       197/1000           0
  isolated zero X/Y/P 13/22/33       0/0/1
  spurious BTN_TOUCH        22           4

Add I2C_HID_QUIRK_UNRELIABLE_INPUT_SIZE. When set, a prefix that
disagrees with the descriptor-declared size for the report ID present
is replaced by that size, provided the payload differs from the
previous one: an unchanged payload means no new report was transferred
and the buffer still holds the old one. Reads carrying a genuinely
truncated report followed by the next report, identifiable by an
embedded copy of the read length, are dropped rather than parsed as a
single oversized report.

The underlying fault is host-side rather than in the device's length
computation: during one 5.17 s outage the same buffer was returned
1590 consecutive times, so no transfer was taking place at all. This
quirk recovers the reports that do arrive; it does not address that
transport defect.

Signed-off-by: Andrew Alexander <andrewalex1992@gmail.com>
---
 drivers/hid/hid-ids.h              |   1 +
 drivers/hid/i2c-hid/i2c-hid-core.c | 104 +++++++++++++++++++++++++++--
 2 files changed, 101 insertions(+), 4 deletions(-)

diff --git a/drivers/hid/hid-ids.h b/drivers/hid/hid-ids.h
index cb7f16d..b8c4786 100644
--- a/drivers/hid/hid-ids.h
+++ b/drivers/hid/hid-ids.h
@@ -722,6 +722,7 @@
 
 #define USB_VENDOR_ID_ILITEK		0x222a
 #define USB_DEVICE_ID_ILITEK_MULTITOUCH	0x0001
+#define I2C_DEVICE_ID_ILITEK_ILI2901	0x5539
 
 #define USB_VENDOR_ID_INTEL_0		0x8086
 #define USB_VENDOR_ID_INTEL_1		0x8087
diff --git a/drivers/hid/i2c-hid/i2c-hid-core.c b/drivers/hid/i2c-hid/i2c-hid-core.c
index a61fd1d..a4f68df 100644
--- a/drivers/hid/i2c-hid/i2c-hid-core.c
+++ b/drivers/hid/i2c-hid/i2c-hid-core.c
@@ -52,6 +52,7 @@
 #define I2C_HID_QUIRK_NO_SLEEP_ON_SUSPEND	BIT(5)
 #define I2C_HID_QUIRK_DELAY_WAKEUP_AFTER_RESUME BIT(6)
 #define I2C_HID_QUIRK_RE_POWER_ON		BIT(7)
+#define I2C_HID_QUIRK_UNRELIABLE_INPUT_SIZE	BIT(8)
 
 /* Command opcodes */
 #define I2C_HID_OPCODE_RESET			0x01
@@ -99,6 +100,7 @@ struct i2c_hid {
 						   * descriptor. */
 	unsigned int		bufsize;	/* i2c buffer size */
 	u8			*inbuf;		/* Input buffer */
+	u8			*prevbuf;	/* Previous input payload */
 	u8			*rawbuf;	/* Raw Input buffer */
 	u8			*cmdbuf;	/* Command buffer */
 
@@ -155,6 +157,12 @@ static const struct i2c_hid_quirks {
 		 I2C_HID_QUIRK_DELAY_WAKEUP_AFTER_RESUME },
 	{ I2C_VENDOR_ID_BLTP, I2C_PRODUCT_ID_BLTP7853,
 		I2C_HID_QUIRK_NO_IRQ_AFTER_RESET },
+	/*
+	 * The ILITEK ILI2901 digitizer returns a corrupted input length
+	 * prefix while the report payload itself is intact.
+	 */
+	{ USB_VENDOR_ID_ILITEK, I2C_DEVICE_ID_ILITEK_ILI2901,
+		I2C_HID_QUIRK_UNRELIABLE_INPUT_SIZE },
 	{ 0, 0 }
 };
 
@@ -527,6 +535,51 @@ static int i2c_hid_finish_hwreset(struct i2c_hid *ihid)
 	return ret;
 }
 
+/*
+ * Size of the input report with the given ID as declared by the report
+ * descriptor, including the leading report ID byte. Zero if unknown.
+ */
+static u32 i2c_hid_input_report_len(struct i2c_hid *ihid, u8 id)
+{
+	struct hid_report_enum *re;
+	struct hid_report *report;
+
+	if (!ihid->hid)
+		return 0;
+
+	re = &ihid->hid->report_enum[HID_INPUT_REPORT];
+	if (!re->numbered)
+		return 0;
+
+	report = re->report_id_hash[id];
+	if (!report || !report->size)
+		return 0;
+
+	return (((report->size - 1) >> 3) + 1) + 1;
+}
+
+/*
+ * A report shorter than its declared size is followed in the same transfer by
+ * the next report, preceded by its own length prefix. Detect that embedded
+ * prefix so such transfers can be dropped rather than parsed as one oversized
+ * report.
+ */
+static bool i2c_hid_has_embedded_prefix(struct i2c_hid *ihid, u32 want,
+					u16 size)
+{
+	u8 lo = size & 0xff, hi = size >> 8;
+	u8 *p = ihid->inbuf + sizeof(__le16);
+	u32 i;
+
+	for (i = 1; i + 2 < want; i++) {
+		if (p[i] == lo && p[i + 1] == hi &&
+		    i2c_hid_input_report_len(ihid, p[i + 2]))
+			return true;
+	}
+
+	return false;
+}
+
 static void i2c_hid_get_input(struct i2c_hid *ihid)
 {
 	u16 size = le16_to_cpu(ihid->hdesc.wMaxInputLength);
@@ -548,10 +601,49 @@ static void i2c_hid_get_input(struct i2c_hid *ihid)
 
 	/* Receiving buffer is properly aligned */
 	ret_size = le16_to_cpup((__le16 *)ihid->inbuf);
-	if (!ret_size) {
+	if (!ret_size &&
+	    test_and_clear_bit(I2C_HID_RESET_PENDING, &ihid->flags)) {
 		/* host or device initiated RESET completed */
-		if (test_and_clear_bit(I2C_HID_RESET_PENDING, &ihid->flags))
-			wake_up(&ihid->wait);
+		wake_up(&ihid->wait);
+		return;
+	}
+
+	if (ihid->quirks & I2C_HID_QUIRK_UNRELIABLE_INPUT_SIZE) {
+		/*
+		 * The input length prefix on this device is unreliable: its low
+		 * byte frequently arrives zeroed, all-ones or bit-shifted while
+		 * the report payload behind it is intact. Where the prefix
+		 * disagrees with the size the report descriptor declares, trust
+		 * the descriptor instead.
+		 */
+		u32 want = i2c_hid_input_report_len(ihid,
+						    ihid->inbuf[sizeof(__le16)]);
+
+		if (!want || want + sizeof(__le16) > size)
+			return;
+
+		if (ret_size != want + sizeof(__le16)) {
+			/*
+			 * A genuinely truncated report is followed by the next
+			 * one in the same transfer. Drop those rather than
+			 * parsing two reports as one.
+			 */
+			if (i2c_hid_has_embedded_prefix(ihid, want, size))
+				return;
+
+			/*
+			 * An unchanged payload means no new report was
+			 * transferred and the buffer still holds the previous
+			 * one.
+			 */
+			if (!memcmp(ihid->inbuf + sizeof(__le16),
+				    ihid->prevbuf, want))
+				return;
+
+			ret_size = want + sizeof(__le16);
+		}
+		memcpy(ihid->prevbuf, ihid->inbuf + sizeof(__le16), want);
+	} else if (!ret_size) {
 		return;
 	}
 
@@ -625,9 +717,11 @@ static void i2c_hid_find_max_report(struct hid_device *hid, unsigned int type,
 static void i2c_hid_free_buffers(struct i2c_hid *ihid)
 {
 	kfree(ihid->inbuf);
+	kfree(ihid->prevbuf);
 	kfree(ihid->rawbuf);
 	kfree(ihid->cmdbuf);
 	ihid->inbuf = NULL;
+	ihid->prevbuf = NULL;
 	ihid->rawbuf = NULL;
 	ihid->cmdbuf = NULL;
 	ihid->bufsize = 0;
@@ -649,10 +743,12 @@ static int i2c_hid_alloc_buffers(struct i2c_hid *ihid, size_t report_size)
 		      report_size;
 
 	ihid->inbuf = kzalloc(report_size, GFP_KERNEL);
+	ihid->prevbuf = kzalloc(report_size, GFP_KERNEL);
 	ihid->rawbuf = kzalloc(report_size, GFP_KERNEL);
 	ihid->cmdbuf = kzalloc(cmd_len, GFP_KERNEL);
 
-	if (!ihid->inbuf || !ihid->rawbuf || !ihid->cmdbuf) {
+	if (!ihid->inbuf || !ihid->prevbuf || !ihid->rawbuf ||
+	    !ihid->cmdbuf) {
 		i2c_hid_free_buffers(ihid);
 		return -ENOMEM;
 	}
-- 
2.54.0

