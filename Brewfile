brew "ffmpeg"
brew "go"
brew "nmap"
brew "node"
brew "ripgrep"
brew "tilt"
brew "wireshark"

cask "nikitabobko/tap/aerospace"
cask "ghostty"
cask "wireshark-app"
cask "xbar"
